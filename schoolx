newSection.innerHTML = `<div class="nav-section-title">Avancé</div> <div class="nav-item" onclick="showPage('cantine')"><span class="icon">🍽️</span> Cantine</div> <div class="nav-item" onclick="showPage('discipline')"><span class="icon">⚖️</span> Discipline</div> <div class="nav-item" onclick="showPage('bulletins')"><span class="icon">📄</span> Bulletins</div> <div class="nav-item" onclick="showPage('analytics')"><span class="icon">📡</span> Analytique</div> <div class="nav-item" onclick="showPage('calendar')"><span class="icon">🗓️</span> Calendrier</div> <div class="nav-item" onclick="showPage('homework')"><span class="icon">📚</span> Devoirs</div>`;
nav.appendChild(newSection);
}

// Inject notification bell + ticker into topbar
function injectTopbarExtras() {
const actions = document.querySelector(’.topbar-actions’);
if (!actions || document.getElementById(‘notif-bell-btn’)) return;

const bell = document.createElement(‘div’);
bell.className = ‘notif-bell’;
bell.id = ‘notif-bell-btn’;
bell.innerHTML = ‘🔔<div class="notif-dot"></div>’;
bell.onclick = toggleNotifPanel;
actions.insertBefore(bell, actions.firstChild);

// Notification panel
const panel = document.createElement(‘div’);
panel.className = ‘notif-panel’;
panel.id = ‘notif-panel’;
panel.innerHTML = `<div class="notif-panel-header"> <div class="title">🔔 Notifications</div> <button class="btn btn-secondary btn-xs" onclick="document.getElementById('notif-panel').classList.remove('open')">✕</button> </div> <div class="notif-panel-item"> <div class="notif-panel-icon">💰</div> <div class="notif-panel-text"> <div class="title">Paiement en attente</div> <div class="time">Il y a 5 minutes</div> </div> </div> <div class="notif-panel-item"> <div class="notif-panel-icon">📅</div> <div class="notif-panel-text"> <div class="title">Examen demain — 6ème A</div> <div class="time">Il y a 1 heure</div> </div> </div> <div class="notif-panel-item"> <div class="notif-panel-icon">👤</div> <div class="notif-panel-text"> <div class="title">Nouvel élève inscrit</div> <div class="time">Il y a 2 heures</div> </div> </div> <div class="notif-panel-item"> <div class="notif-panel-icon">⚠️</div> <div class="notif-panel-text"> <div class="title">Stock papier faible — 3 restants</div> <div class="time">Il y a 3 heures</div> </div> </div>`;
document.body.appendChild(panel);

// Ticker
const main = document.querySelector(’.main’);
const ticker = document.createElement(‘div’);
ticker.className = ‘ticker’;
ticker.style.cssText = ‘position:fixed;bottom:0;left:260px;right:0;z-index:150’;
ticker.innerHTML = ` <span class="ticker-label">📢 Infos</span> <div class="ticker-scroll"> <div class="ticker-inner"> <span class="ticker-item">Fin du 1er trimestre : 15 décembre</span> <span class="ticker-item">Réunion parents-professeurs : samedi 10h</span> <span class="ticker-item">Dépôt des notes : avant le 20</span> <span class="ticker-item">Paiement des salaires prévu le 28</span> <span class="ticker-item">Fermeture exceptionnelle : Lundi prochain</span> <span class="ticker-item">Stock de craies à réapprovisionner</span> </div> </div>`;
document.body.appendChild(ticker);
main.style.paddingBottom = ‘48px’;
}

// FAB button
function injectFAB() {
if (document.getElementById(‘main-fab’)) return;
const fab = document.createElement(‘button’);
fab.className = ‘fab’;
fab.id = ‘main-fab’;
fab.title = ‘Action rapide’;
fab.innerHTML = ‘+’;
fab.onclick = () => mainAction();
document.body.appendChild(fab);
}

// Attach extensions when app loads
const _origInitApp = initApp;
initApp = async function(user) {
await _origInitApp(user);
injectExtendedNav();
injectTopbarExtras();
injectFAB();
};

// Close notif panel on outside click
document.addEventListener(‘click’, (e) => {
const panel = document.getElementById(‘notif-panel’);
const bell = document.getElementById(‘notif-bell-btn’);
if (panel && !panel.contains(e.target) && bell && !bell.contains(e.target)) {
panel.classList.remove(‘open’);
}
});
</script>

