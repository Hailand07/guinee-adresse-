    const past = e.exam_date < today;
    return `<tr>
      <td><strong>${e.name}</strong></td>
      <td><span class="badge badge-blue">${e.classes?.name||'—'}</span></td>
      <td>${e.subject||'—'}</td>
      <td>${e.exam_date||'—'}</td>
      <td>${e.duration_minutes ? e.duration_minutes+'min' : '—'}</td>
      <td>${e.room||'—'}</td>
