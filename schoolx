async function loadInventory() {
  if (!schoolId()) return;
  const { data } = await db.from('inventory').select('*').eq('school_id',schoolId()).order('name');
  const tbody = document.getElementById('inventory-table');
  if (!data?.length) { tbody.innerHTML='<tr><td colspan="8"><div class="empty"><div class="icon">📦</div><p>Stock vide</p></div></td></tr>'; return; }
  const low = data.filter(i=>i.quantity<=i.alert_threshold).length;
  document.getElementById('inv-total').textContent = data.length;
  document.getElementById('inv-low').textContent = low;
  tbody.innerHTML = data.map(i => {
    const isLow = i.quantity <= i.alert_threshold;
    return `<tr>
      <td><strong>${i.name}</strong></td>
      <td><span class="badge badge-blue">${capitalize(i.category||'')}</span></td>
      <td style="${isLow?'color:var(--danger);font-weight:700':''}">
        ${i.quantity} ${isLow?'<span class="badge badge-red">⚠️ Stock bas</span>':''}
      </td>
      <td>${i.alert_threshold||'—'}</td>
      <td>${fmt(i.unit_price||0)} FCFA</td>
      <td>${fmt((i.quantity||0)*(i.unit_price||0))} FCFA</td>
      <td>${isLow?'<span class="badge badge-red">Critique</span>':'<span class="badge badge-green">Normal</span>'}</td>
      <td>
        <div style="display:flex;gap:4px">
          <button class="btn btn-success btn-xs" onclick="adjustStock('${i.id}',1)">+</button>
          <button class="btn btn-danger btn-xs" onclick="adjustStock('${i.id}',-1)">−</button>
        </div>
      </td>
    </tr>`;
  }).join('');
}

async function saveInventory() {
  if (!schoolId()) return;
  const name = document.getElementById('inv-name').value.trim();
  const qty = Number(document.getElementById('inv-qty').value);
  if (!name || !qty) { showNotif('Nom et quantité sont obligatoires','error'); return; }
  const { error } = await db.from('inventory').insert({
    school_id:schoolId(), name, category:document.getElementById('inv-cat').value,
    quantity:qty, alert_threshold:Number(document.getElementById('inv-threshold').value)||5,
    unit_price:Number(document.getElementById('inv-price').value)||0,
    supplier:document.getElementById('inv-supplier').value||null,
  });
  if (error) { showNotif('Erreur: '+error.message,'error'); return; }
  showNotif('Article ajouté !','success');
  await loadInventory();
}

async function adjustStock(id, delta) {
  const { data } = await db.from('inventory').select('quantity').eq('id',id).single();
  const newQty = Math.max(0, (data?.quantity||0)+delta);
  await db.from('inventory').update({quantity:newQty}).eq('id',id);
  await loadInventory();
}

