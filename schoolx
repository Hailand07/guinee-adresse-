  document.getElementById('msg-body').value='';
  document.getElementById('msg-subject').value='';
  await loadMessages();
}

async function loadMessages() {
  if (!schoolId()) return;
  const { data } = await db.from('messages').select('*').eq('school_id',schoolId()).order('created_at',{ascending:false}).limit(10);
  const el = document.getElementById('messages-list');
  if (!data?.length) { el.innerHTML='<div class="empty"><div class="icon">💬</div><p>Aucun message</p></div>'; return; }
  el.innerHTML = data.map(m => `
    <div style="padding:12px;background:var(--surface2);border-radius:10px;margin-bottom:8px;border-left:3px solid var(--accent)">
      <div style="font-weight:600;font-size:14px">${m.subject||'Sans objet'}</div>
      <div style="font-size:12px;color:var(--text2);margin-top:4px">${m.body?.slice(0,80)}${m.body?.length>80?'...':''}</div>
      <div style="font-size:11px;color:var(--text3);margin-top:6px">
        ${capitalize(m.channel||'')} · ${capitalize(m.recipients_type||'')} · ${new Date(m.created_at).toLocaleDateString('fr-FR')}
      </div>
    </div>`).join('');
}

