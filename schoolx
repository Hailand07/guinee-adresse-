async function loadGradeStudents() {
  const classId = document.getElementById('grade-class').value;
  const tbody = document.getElementById('grades-table');
  if (!classId) return;
  const { data } = await db.from('students').select('id,first_name,last_name').eq('class_id',classId).order('last_name');
  gradesState = {};
  if (!data?.length) { tbody.innerHTML='<tr><td colspan="4"><div class="empty"><p>Aucun élève</p></div></td></tr>'; return; }
  tbody.innerHTML = data.map((s,i) => {
    gradesState[s.id] = { name:`${s.last_name} ${s.first_name}` };
    return `<tr>
      <td>${i+1}</td>
      <td><strong>${s.last_name} ${s.first_name}</strong></td>
      <td><input type="number" min="0" max="20" step="0.25" class="form-group" style="background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:8px;color:var(--text);width:80px;outline:none" id="grade-${s.id}" placeholder="—" oninput="updateGradeLabel('${s.id}')"></td>
      <td><span id="grade-label-${s.id}" style="color:var(--text3);font-size:13px">—</span></td>
    </tr>`;
  }).join('');
}

function updateGradeLabel(id) {
  const val = parseFloat(document.getElementById('grade-'+id).value);
  const el = document.getElementById('grade-label-'+id);
  if (isNaN(val)) { el.textContent='—'; return; }
  if (val>=16) el.innerHTML='<span class="badge badge-green">Très bien</span>';
  else if (val>=14) el.innerHTML='<span class="badge badge-blue">Bien</span>';
  else if (val>=12) el.innerHTML='<span class="badge badge-cyan">Assez bien</span>';
  else if (val>=10) el.innerHTML='<span class="badge badge-yellow">Passable</span>';
  else el.innerHTML='<span class="badge badge-red">Insuffisant</span>';
}

async function saveGrades() {
  const classId = document.getElementById('grade-class').value;
  const subject = document.getElementById('grade-subject').value;
  const term = document.getElementById('grade-term').value;
  const type = document.getElementById('grade-type').value;
  if (!classId) { showNotif('Sélectionnez une classe','error'); return; }
  const records = [];
  for (const id of Object.keys(gradesState)) {
    const val = parseFloat(document.getElementById('grade-'+id)?.value);
    if (!isNaN(val)) records.push({ school_id:schoolId(), student_id:id, class_id:classId, subject, term, grade_type:type, score:val, max_score:20 });
  }
  if (!records.length) { showNotif('Aucune note saisie','error'); return; }
  const { error } = await db.from('grades').insert(records);
  if (error) { showNotif('Erreur: '+error.message,'error'); return; }
  showNotif(`${records.length} notes enregistrées !`,'success');
}

