// DISCIPLINE
// ═══════════════════════════════════════════════════════════
async function loadDiscipline() {
if (!schoolId()) return;
await loadStudentsIntoSelect(‘disc-student’);
const today = new Date(); const ym = `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}`;
const el = document.getElementById(‘disc-date’); if(el) el.value = today.toISOString().split(‘T’)[0];

const { data } = await db.from(‘discipline’).select(’*,students(first_name,last_name)’)
.eq(‘school_id’,schoolId()).order(‘created_at’,{ascending:false}).limit(50);
const list = document.getElementById(‘discipline-list’);
if (!list) return;
if (!data?.length) { list.innerHTML=’<div class="empty"><div class="icon">✅</div><p>Aucun incident ce mois</p></div>’; return; }
const month = data.filter(d=>d.incident_date?.startsWith(ym));
document.getElementById(‘disc-total’).textContent = month.length;
