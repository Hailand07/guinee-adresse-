async function loadAttendanceStudents() {
  const classId = document.getElementById('att-class').value;
  const grid = document.getElementById('attendance-grid');
  if (!classId) { grid.innerHTML='<div class="empty"><div class="icon">🏫</div><p>Sélectionnez une classe</p></div>'; return; }
  const { data } = await db.from('students').select('id,first_name,last_name').eq('class_id',classId).eq('status','actif').order('last_name');
  attendanceState = {};
  if (!data?.length) { grid.innerHTML='<div class="empty"><div class="icon">👨‍🎓</div><p>Aucun élève dans cette classe</p></div>'; return; }
  grid.innerHTML = data.map(s => `
    <div class="student-att" id="att-${s.id}" onclick="toggleAtt('${s.id}')">
      <div style="font-size:28px">👤</div>
      <div class="s-name">${s.last_name}<br>${s.first_name}</div>
      <div class="s-id" id="att-status-${s.id}">— Cliquer —</div>
    </div>`).join('');
  data.forEach(s => { attendanceState[s.id] = null; });
}

function toggleAtt(id) {
  const states = [null, 'present', 'absent', 'late'];
  const labels = { null:'— Cliquer —', present:'✓ Présent', absent:'✗ Absent', late:'⏱ Retard' };
  const current = attendanceState[id];
  const next = states[(states.indexOf(current)+1)%states.length];
  attendanceState[id] = next;
  const el = document.getElementById('att-'+id);
  el.className = 'student-att' + (next?' '+next:'');
  document.getElementById('att-status-'+id).textContent = labels[next];
}

async function saveAttendance() {
  const classId = document.getElementById('att-class').value;
  const date = document.getElementById('att-date').value;
  const session = document.getElementById('att-session').value;
  if (!classId || !date) { showNotif('Sélectionnez une classe et une date','error'); return; }
  const records = Object.entries(attendanceState)
    .filter(([,v]) => v)
    .map(([studentId, status]) => ({ school_id:schoolId(), student_id:studentId, class_id:classId, date, session, status }));
  if (!records.length) { showNotif('Aucune présence saisie','error'); return; }
  // Upsert records
  const { error } = await db.from('attendance').upsert(records, { onConflict:'student_id,date,session' });
  if (error) { showNotif('Erreur: '+error.message,'error'); return; }
  showNotif(`${records.length} présences enregistrées !`,'success');
}

