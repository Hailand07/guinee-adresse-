    school_id:schoolId(), recipients_type:document.getElementById('msg-to').value,
    class_id:document.getElementById('msg-class').value||null,
    subject:document.getElementById('msg-subject').value, body,
    channel:document.getElementById('msg-channel').value,
    sent_by:currentUser?.id,
