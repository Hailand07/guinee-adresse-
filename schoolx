async function loadPayments() {
  if (!schoolId()) return;
  const month = document.getElementById('pay-month-filter').value;
  let query = db.from('payments').select('*,students(first_name,last_name,classes(name))').eq('school_id',schoolId()).order('created_at',{ascending:false});
  if (month) { query = query.gte('payment_date',month+'-01').lte('payment_date',month+'-31'); }
  const { data } = await query;
  const tbody = document.getElementById('payments-table');
  if (!data?.length) { tbody.innerHTML='<tr><td colspan="9"><div class="empty"><div class="icon">💰</div><p>Aucun paiement ce mois</p></div></td></tr>'; return; }
  const total = data.filter(p=>p.status==='paid').reduce((a,p)=>a+Number(p.amount),0);
  const pending = data.filter(p=>p.status!=='paid').length;
  const rate = data.length ? Math.round(data.filter(p=>p.status==='paid').length/data.length*100) : 0;
  document.getElementById('pay-total').textContent = fmt(total);
  document.getElementById('pay-pending-count').textContent = pending;
  document.getElementById('pay-rate').textContent = rate+'%';
  tbody.innerHTML = data.map(p => `<tr>
    <td><span style="font-size:12px;color:var(--text3)">${p.reference||'—'}</span></td>
    <td>${p.students?.last_name||'—'} ${p.students?.first_name||''}</td>
    <td><span class="badge badge-blue">${p.students?.classes?.name||'—'}</span></td>
    <td>${capitalize(p.payment_type||'')}</td>
    <td><strong>${fmt(p.amount)} FCFA</strong></td>
    <td>${p.payment_date||'—'}</td>
    <td><span class="badge badge-gray">${capitalize(p.payment_method||'')}</span></td>
    <td>${payBadge(p.status)}</td>
    <td><button class="btn btn-secondary btn-xs" onclick="showReceipt('${p.id}')">🧾</button></td>
  </tr>`).join('');

  // Load pending
  const pending_data = await db.from('students')
    .select('*,classes(name)')
    .eq('school_id',schoolId())
    .neq('payment_status','paid');
  const pendingTbody = document.getElementById('pending-table');
  if (!pending_data.data?.length) {
    pendingTbody.innerHTML='<tr><td colspan="7"><div class="empty"><div class="icon">✅</div><p>Aucun impayé !</p></div></td></tr>';
  } else {
    pendingTbody.innerHTML = pending_data.data.map(s => `<tr>
      <td><strong>${s.last_name} ${s.first_name}</strong></td>
      <td><span class="badge badge-blue">${s.classes?.name||'—'}</span></td>
      <td>${fmt(s.tuition_fee||0)} FCFA</td>
      <td>0 FCFA</td>
      <td style="color:var(--danger);font-weight:700">${fmt(s.tuition_fee||0)} FCFA</td>
      <td><span class="badge badge-red">En retard</span></td>
      <td><button class="btn btn-primary btn-xs" onclick="quickPay('${s.id}','${s.last_name} ${s.first_name}',${s.tuition_fee||0})">💳 Payer</button></td>
    </tr>`).join('');
  }
}

