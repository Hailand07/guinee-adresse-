async function renderCalendar() {
const grid = document.getElementById(‘cal-grid’);
if (!grid) return;
const y = calCurrentDate.getFullYear(), m = calCurrentDate.getMonth();
const months = [‘Janvier’,‘Février’,‘Mars’,‘Avril’,‘Mai’,‘Juin’,‘Juillet’,‘Août’,‘Septembre’,‘Octobre’,‘Novembre’,‘Décembre’];
const titleEl = document.getElementById(‘cal-month-title’);
if (titleEl) titleEl.textContent = `${months[m]} ${y}`;

// First day of month (Monday-based)
const firstDay = new Date(y, m, 1);
let startDow = firstDay.getDay(); // 0=Sun
startDow = startDow === 0 ? 6 : startDow - 1; // convert to Monday=0

const daysInMonth = new Date(y, m+1, 0).getDate();
const today = new Date();

// Fetch events
const startStr = `${y}-${String(m+1).padStart(2,'0')}-01`;
const endStr = `${y}-${String(m+1).padStart(2,'0')}-${String(daysInMonth).padStart(2,'0')}`;
const { data: exams } = schoolId() ? await db.from(‘exams’).select(‘exam_date,name’).eq(‘school_id’,schoolId()).gte(‘exam_date’,startStr).lte(‘exam_date’,endStr) : {data:[]};
const { data: payments } = schoolId() ? await db.from(‘payments’).select(‘payment_date,payment_type’).eq(‘school_id’,schoolId()).gte(‘payment_date’,startStr).lte(‘payment_date’,endStr) : {data:[]};

const cells = [];
// Empty cells before first day
for (let i=0; i<startDow; i++) cells.push(`<div class="cal-cell other-month"></div>`);
// Days
for (let d=1; d<=daysInMonth; d++) {
const dateStr = `${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
const isToday = y===today.getFullYear() && m===today.getMonth() && d===today.getDate();
const dayExams = (exams||[]).filter(e=>e.exam_date===dateStr);
const dayPays = (payments||[]).filter(p=>p.payment_date===dateStr);
cells.push(`<div class="cal-cell ${isToday?'today':''}" onclick="calDayClick('${dateStr}')"> <div class="cal-date">${d}</div> ${dayExams.map(e=>`<div class="cal-event exam">🎯 ${e.name?.slice(0,14)}</div>`).join('')} ${dayPays.slice(0,2).map(p=>`<div class="cal-event payment">💰 Paiement</div>`).join('')} </div>`);
}
// Fill remaining cells
const total = cells.length;
const rows = Math.ceil(total/7)*7;
for (let i=total; i<rows; i++) cells.push(`<div class="cal-cell other-month"></div>`);
grid.innerHTML = cells.join(’’);

// Events list
const listEl = document.getElementById(‘cal-events-list’);
if (listEl) {
const allEvents = [
…(exams||[]).map(e=>({date:e.exam_date, title:e.name, type:‘exam’, icon:‘🎯’})),
…(payments||[]).slice(0,5).map(p=>({date:p.payment_date, title:‘Paiement enregistré’, type:‘payment’, icon:‘💰’})),
].sort((a,b)=>a.date.localeCompare(b.date));
if (!allEvents.length) {
listEl.innerHTML = ‘<div class="empty"><div class="icon">📅</div><p>Aucun événement ce mois</p></div>’;
} else {
listEl.innerHTML = allEvents.slice(0,10).map(ev=>` <div style="display:flex;gap:12px;padding:12px;border-bottom:1px solid var(--border);align-items:center"> <div style="font-size:24px">${ev.icon}</div> <div><div style="font-weight:600;font-size:14px">${ev.title}</div><div style="font-size:12px;color:var(--text3)">${ev.date}</div></div> <span class="badge badge-${ev.type==='exam'?'red':'green'}" style="margin-left:auto">${ev.type==='exam'?'Examen':'Paiement'}</span> </div>`).join(’’);
}
}
}

