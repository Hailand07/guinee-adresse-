// CANTINE
// ═══════════════════════════════════════════════════════════
async function loadCantine() {
if (!schoolId()) return;
// Load stats from students subscribed
const { count } = await db.from(‘students’)
.select(’*’,{count:‘exact’,head:true})
.eq(‘school_id’, schoolId());
document.getElementById(‘cant-subscribers’).textContent = Math.round((count||0) * 0.45);
document.getElementById(‘cant-revenue’).textContent = fmt(Math.round((count||0)*0.45)*500*20);
document.getElementById(‘cant-today’).textContent = Math.round((count||0)*0.42);

// Load menu
const { data } = await db.from(‘cantine_menu’)
.select(’*’).eq(‘school_id’, schoolId()).order(‘day_order’);
const grid = document.getElementById(‘cantine-menu-grid’);
if (!grid) return;

const days = [‘Lundi’,‘Mardi’,‘Mercredi’,‘Jeudi’,‘Vendredi’];
const meals = data || [];
grid.innerHTML = days.map(day => {
const dayMeals = meals.filter(m => m.day === day);
return `<div class="menu-day"> <div class="menu-day-title">📅 ${day}</div> ${dayMeals.length ? dayMeals.map(m => `
<div class="menu-item">
<span class="meal-type">${m.meal_type===‘dejeuner’?‘🍽️’:m.meal_type===‘gouter’?‘🧃’:‘☕’} ${m.meal_type}</span>
<div>
<div style="font-weight:600;font-size:13px">${m.main_dish}</div>
${m.side_dish ? `<div style="font-size:11px;color:var(--text3)">${m.side_dish}</div>`:’’}
${m.price ? `<div style="font-size:12px;color:var(--success);font-weight:600">${fmt(m.price)} FCFA</div>`:’’}
</div>
</div>`).join('') : `<div style="color:var(--text3);font-size:13px;padding:10px 0">Aucun menu saisi</div>`} </div>`;
}).join(’’);

// Subs table
const { data: students } = await db.from(‘students’)
.select(’*,classes(name)’).eq(‘school_id’,schoolId()).limit(20);
const stbody = document.getElementById(‘cantine-subs-table’);
if (!stbody || !students?.length) return;
stbody.innerHTML = students.slice(0,12).map(s => `<tr>
<td><strong>${s.last_name} ${s.first_name}</strong></td>
<td><span class="badge badge-blue">${s.classes?.name||’—’}</span></td>
<td>Déjeuner quotidien</td>
<td>10 000 FCFA / mois</td>
<td><span class="badge badge-green">Payé</span></td>
<td><button class="btn btn-secondary btn-xs">Voir</button></td>

  </tr>`).join('');
}

async function saveCantineMenu() {
if (!schoolId()) return;
const days = [‘Lundi’,‘Mardi’,‘Mercredi’,‘Jeudi’,‘Vendredi’];
const day = document.getElementById(‘cant-day’).value;
const main = document.getElementById(‘cant-main’).value.trim();
if (!main) { showNotif(‘Le plat principal est obligatoire’,‘error’); return; }
const { error } = await db.from(‘cantine_menu’).insert({
school_id: schoolId(), day, day_order: days.indexOf(day),
meal_type: document.getElementById(‘cant-type’).value,
main_dish: main, side_dish: document.getElementById(‘cant-side’).value||null,
price: Number(document.getElementById(‘cant-price’).value)||500,
week_start: document.getElementById(‘cant-week’).value||null,
});
if (error) { showNotif(’Erreur: ’+error.message,‘error’); return; }
showNotif(‘Menu ajouté !’,‘success’);
await loadCantine();
}

