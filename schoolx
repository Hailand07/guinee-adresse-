  const today = new Date().toISOString().split('T')[0];
  document.getElementById('exam-count').textContent = data.length;
  document.getElementById('exam-done').textContent = data.filter(e=>e.exam_date<today).length;
  document.getElementById('exam-upcoming').textContent = data.filter(e=>e.exam_date>=today).length;
