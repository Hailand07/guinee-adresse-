function switchTabByName(id) {
  const el = document.getElementById(id);
  if (!el) return;
  el.parentElement.querySelectorAll('[id^="tab-"]').forEach(t => t.style.display = 'none');
  el.style.display = 'block';
  const tabs = el.parentElement.previousElementSibling;
  if (tabs?.classList.contains('tabs')) {
    tabs.querySelectorAll('.tab').forEach((t,i) => t.classList.toggle('active', i === [...tabs.querySelectorAll('.tab')].indexOf(tabs.querySelectorAll('.tab')[i])));
  }
}

function switchTab(el, targetId) {
  const tabs = el.parentElement;
  const content = tabs.nextElementSibling?.parentElement || document;
  tabs.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  // find tab contents in same section
  const siblings = document.querySelectorAll('[id^="' + targetId.split('-').slice(0,-1).join('-') + '"]');
  siblings.forEach(s => s.style.display = 'none');
  const target = document.getElementById(targetId);
  if (target) target.style.display = 'block';
}

